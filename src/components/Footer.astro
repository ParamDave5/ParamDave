---
import { mailto, github, linkedin } from '../data/site';

const year = new Date().getFullYear();
---
<footer class="site-footer border-t border-stone-200 dark:border-stone-800">
  <div class="mx-auto grid max-w-5xl gap-4 px-6 py-8 text-sm text-stone-500 sm:grid-cols-[auto_1fr_auto] sm:items-center dark:text-stone-500">
    <p>© {year} Param Dave</p>
    <p class="text-xs text-stone-600 sm:text-center dark:text-stone-400">
      Machine learning · Computer vision · Robotics
    </p>
    <div class="flex items-center gap-4">
      <a href={mailto} class="hover:text-amber-600 dark:hover:text-amber-400">Email</a>
      <a href={github} target="_blank" rel="noopener" class="hover:text-amber-600 dark:hover:text-amber-400">GitHub</a>
      <a href={linkedin} target="_blank" rel="noopener" class="hover:text-amber-600 dark:hover:text-amber-400">LinkedIn</a>
    </div>
  </div>
</footer>
