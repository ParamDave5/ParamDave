---
// A hand-drawn horizontal rule. vector-effect keeps the stroke even when the
// viewBox is stretched to the container width.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<svg
  class={`w-full text-stone-300 dark:text-stone-700 ${className}`}
  height="9"
  viewBox="0 0 1200 9"
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M0 5.4c48-2.8 96-4 144-3.1 48 .9 96 3.9 144 4.4 48 .5 96-1.5 144-2.6 48-1.1 96-1.3 144 .2 48 1.5 96 4.7 144 5 48 .3 96-2.3 144-3.6 48-1.3 96-1.3 144-.4 32 .6 64 1.7 96 2.6"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  />
</svg>
