---
import { resumeUrl } from '../data/site';

const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/research', label: 'Research' },
  { href: '/experience', label: 'Experience' },
];

const isActive = (href: string) => {
  const current = pathname.replace(base, '').replace(/\/$/, '') || '/';
  return current === href;
};
---
<nav class="site-nav sticky top-0 z-40 border-b">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-2.5">
    <a href={`${base}/`} class="site-brand hover:text-amber-600 dark:hover:text-amber-400">
      <span class="brand-mark" aria-hidden="true">pd.</span> Param Dave
    </a>
    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-5 text-sm md:flex">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={`${base}${href === '/' ? '' : href}`}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'transition-colors',
                isActive(href)
                  ? 'text-amber-600 dark:text-amber-400'
                  : 'text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={resumeUrl}
            target="_blank"
            rel="noopener"
            class="text-stone-600 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
          >
            Résumé ↗
          </a>
        </li>
      </ul>
      <button
        id="theme-toggle"
        type="button"
        class="flex min-h-11 min-w-11 items-center justify-center rounded-md border border-stone-200 p-2 text-stone-600 hover:border-stone-400 hover:text-stone-900 dark:border-stone-800 dark:text-stone-400 dark:hover:border-stone-600 dark:hover:text-stone-100"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="border-t border-stone-200 px-6 py-2 dark:border-stone-800 md:hidden">
    <ul class="flex flex-wrap items-center gap-x-4 text-sm">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={`${base}${href === '/' ? '' : href}`}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'inline-flex min-h-10 items-center',
              isActive(href)
                ? 'text-amber-600 dark:text-amber-400'
                : 'text-stone-600 dark:text-stone-400',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a href={resumeUrl} target="_blank" rel="noopener" class="inline-flex min-h-10 items-center text-stone-600 dark:text-stone-400">
          Résumé ↗
        </a>
      </li>
    </ul>
  </div>
</nav>
