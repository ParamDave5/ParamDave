---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { github, linkedin } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Param Dave | Machine Learning, Robotics & Research",
  description = "Machine learning engineer working across reliable AI systems, computer vision, and robotics. Explore research, selected projects, and engineering experience.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const ogImage = `${siteUrl}${base}/og.png`;
const canonicalUrl = `${siteUrl}${base}${Astro.url.pathname.replace(base, '') || '/'}`;

// Declared here rather than in global.css so the font URL picks up the base path.
const fontFace = `@font-face{font-family:'Caveat Note';src:url('${base}/fonts/caveat-note.woff2') format('woff2');font-weight:500;font-style:normal;font-display:swap;}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Param Dave',
  url: `${siteUrl}${base}/`,
  image: ogImage,
  jobTitle: 'Senior Machine Learning Engineer',
  worksFor: { '@type': 'Organization', name: 'TRC Inc' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Maryland, College Park' },
    { '@type': 'CollegeOrUniversity', name: 'Nirma University' },
  ],
  knowsAbout: [
    'Machine learning engineering',
    'LLM evaluation',
    'Agentic systems',
    '3D perception',
    'Computer vision',
    'Robotics',
  ],
  sameAs: [github, linkedin],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141613" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <style is:inline set:html={fontFace}></style>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)}></script>

    <script is:inline>
      try {
        document.documentElement.classList.toggle('dark', localStorage.getItem('theme') === 'dark');
      } catch { /* Keep the default theme when browser storage is unavailable. */ }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-stone-900 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white dark:focus:bg-amber-400 dark:focus:text-stone-900"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      btn?.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
      btn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch { /* Theme still works without persistence. */ }
        btn.setAttribute('aria-pressed', String(isDark));
      });

      // Looping clips are decorative; hold them on the poster frame if the
      // visitor has asked for reduced motion.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const video of document.querySelectorAll('video[autoplay]')) {
          video.removeAttribute('autoplay');
          video.pause();
        }
      }
    </script>
  </body>
</html>
