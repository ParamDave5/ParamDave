---
import Layout from '../layouts/Layout.astro';

const groups: { name: string; items: string[] }[] = [
  {
    name: 'Languages',
    items: ['Python', 'C++', 'CUDA', 'SQL', 'Swift'],
  },
  {
    name: 'LLMs & Agents',
    items: ['vLLM', 'SGLang', 'llama.cpp', 'Unsloth', 'TRL', 'LangChain', 'LightOnOCR', 'Qwen3-VL', 'LoRA / QLoRA', 'PPO / GRPO / DAPO / PAPO', 'LLM-as-Judge Rewards', 'Speculative Decoding', 'Schema-constrained Decoding', 'Agent Harness Design', 'LLM Eval'],
  },
  {
    name: 'ML / DL',
    items: ['PyTorch', 'PyTorch DDP', 'TensorFlow', 'Distributed Training', 'ONNX', 'TensorRT', 'Hugging Face', 'scikit-learn'],
  },
  {
    name: 'Computer Vision & 3D',
    items: ['OpenCV', 'YOLO', 'DETR', '3D Gaussian Splatting', '2DGS', 'GLOMAP', 'COLMAP', 'OpenSFM', 'ARKit', 'SLAM'],
  },
  {
    name: 'LiDAR & Geospatial',
    items: ['PDAL', 'laspy', 'ArcGIS Pro', 'Open3D', 'RandLANet', 'PointCNN', 'KDTree spatial ops'],
  },
  {
    name: 'Infra',
    items: ['Docker', 'AWS', 'Google Cloud', 'Linux', 'Git', 'CI/CD'],
  },
];

const alsoFamiliar = [
  'C', 'Shell', 'MATLAB',
  'Keras', 'NLTK',
  'NumPy', 'Pandas', 'SciPy', 'Matplotlib',
  'MySQL', 'MongoDB', 'SQLite', 'SQL Server',
  'ROS2', 'Gazebo', 'RVIZ', 'Isaac Sim', 'MoveIt',
  'JIRA', 'Faster R-CNN', 'SSD',
];
---
<Layout
  title="Skills — Param Dave"
  description="Languages, LLM and agent tooling, deep learning frameworks, computer vision and 3D, LiDAR and geospatial, and infrastructure Param Dave works with."
>
  <section class="mx-auto max-w-3xl px-6 pt-14 pb-8">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Skills</h1>
    <p class="mt-4 text-stone-600 dark:text-stone-400">
      Tools and frameworks I'd defend in a technical interview.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-9">
    <div class="space-y-8">
      {groups.map((g) => (
        <div>
          <h2 class="text-xs font-semibold text-stone-500">{g.name}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {g.items.map((item) => (
              <li class="rounded-md border border-stone-200 bg-stone-50 px-3 py-1.5 text-sm text-stone-700 dark:border-stone-800 dark:bg-stone-900 dark:text-stone-300">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-12 border-t border-stone-200 pt-8 dark:border-stone-800">
    <h2 class="text-xs font-semibold text-stone-500">Also familiar with</h2>
    <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
      {alsoFamiliar.join(' · ')}
    </p>
    <p class="mt-4 text-sm text-stone-500">
      JIRA is on this list because someone always asks.
    </p>
  </section>
</Layout>
