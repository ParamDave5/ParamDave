---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const routes = [
  { href: '/projects', label: 'Selected work', copy: 'Case studies in evaluation, document intelligence, and 3D perception.' },
  { href: '/research', label: 'Research', copy: 'Publications, awards, and competition results.' },
  { href: '/experience', label: 'Experience', copy: 'The chronological, role-by-role record.' },
  { href: '/', label: 'Home', copy: 'Profile, education, and selected work.' },
];
---
<Layout title="Page not found — Param Dave" description="That page does not exist.">
  <section class="relative mx-auto max-w-5xl overflow-hidden px-6 pt-14 pb-12 sm:pt-16">
    <p class="font-mono text-xs tracking-widest text-amber-600 uppercase dark:text-amber-400">404</p>
    <p
      class="pointer-events-none absolute -top-6 -right-10 -z-10 rotate-6 text-[11rem] leading-none font-bold text-stone-100 select-none sm:-top-4 sm:text-[18rem] dark:text-stone-900"
      aria-hidden="true"
    >
      404
    </p>
    <h1 class="mt-3 max-w-2xl text-2xl font-semibold tracking-tight sm:text-4xl">
      This page doesn't exist.
    </h1>
    <p class="mt-5 max-w-xl text-base text-stone-600 dark:text-stone-400">
      Which is awkward, because I spend my working hours building systems that diagnose exactly this kind of failure. Here's everything that does exist.
    </p>

    <div class="mt-10 grid gap-3 sm:grid-cols-2">
      {routes.map(({ href, label, copy }) => (
        <a
          href={`${base}${href}`}
          class="group border-t-2 border-stone-300 pt-3 transition-colors hover:border-amber-500 dark:border-stone-700 dark:hover:border-amber-400"
        >
          <span class="block text-sm font-semibold">{label} →</span>
          <span class="mt-1 block text-sm text-stone-600 dark:text-stone-400">{copy}</span>
        </a>
      ))}
    </div>

    <a
      href={`${base}/`}
      class="mt-8 inline-block rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700 dark:bg-amber-400 dark:text-stone-900 dark:hover:bg-amber-300"
    >
      Back home
    </a>
  </section>
</Layout>
