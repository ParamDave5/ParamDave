        alt: 'Probability-weighted boundary map produced by the PB-lite detector.',
      },
      {
        title: 'Panorama Stitching',
        year: '2021',
        description: 'Automatic multi-image stitching with feature matching and homography-based warping.',
        github: 'https://github.com/ParamDave5/Panoram-Stiching',
        image: 'panorama.webp',
