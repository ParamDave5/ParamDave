---
import Layout from '../layouts/Layout.astro';
import Meme from '../components/Meme.astro';
import GeniePipeline from '../components/GeniePipeline.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type CaseStudy = {
  id: string;
  area: string;
  title: string;
  period: string;
  question: string;
  context: string;
  approach: string[];
  deadEnd?: { approach: string; why: string };
  outcome: string;
  evidence: string[];
  stack: string[];
  status?: string;
};

const caseStudies: CaseStudy[] = [
  {
    id: 'reliable-agents',
    area: 'Agent evaluation',
    title: 'Making agent failures diagnosable',
    period: '2025 – Present',
    question:
      'How do you tell whether an agent failed at perception, generation, evaluation, or verification?',
    context:
      'Aggregate scores could show that an agent failed, but not which component or behavior caused the failure. The evaluation system needed to catch weaknesses before release and turn failures observed in production into specific, actionable diagnoses.',
    approach: [
      'Built automated grading, adversarial probing, and red-teaming workflows with Promptfoo, Garak, and DeepEval.',
      'Implemented a custom BinEval-style decomposition that separates perception, generation, evaluation, and verification failures.',
      'Adapted Genie into a synthetic document Q&A pipeline tuned to generate questions that resemble real user intent.',
    ],
    outcome:
      'Built the team’s evaluation harness for pre-production quality gates and post-production diagnosis, making failed runs easier to reproduce, classify, and route toward the right system improvement.',
    evidence: ['Pre-production quality gates', 'Post-production diagnosis', 'Failure-mode decomposition', 'Human-like synthetic Q&A'],
    stack: ['Promptfoo', 'Garak', 'DeepEval', 'BinEval', 'Genie', 'Arize Phoenix', 'Sonar Cube'],
  },
  {
    id: 'document-intelligence',
    area: 'Document intelligence',
    title: 'Turning difficult documents into reliable structured data',
    period: '2025 – 2026',
    question:
      'How do you extract schema-constrained data from difficult engineering documents without allowing silent errors to propagate?',
    context:
      'The document mix included handwriting, low-resolution scans, complex layouts, and domain-specific symbols. Outputs also had to conform to a downstream schema, so a plausible answer wasn\'t enough when silent errors could propagate through the workflow.',
    approach: [
      'Benchmarked open-source vision-language models and paired LightOnOCR2 with a prompt-engineered LLM stage.',
      'Produced schema-constrained JSON with validation designed around the downstream application workflow.',
      'Built a verification database that captures human corrections and feeds them back into the extraction loop.',
    ],
    deadEnd: {
      approach:
        'The pipeline started as a single multimodal LLM: PDF in, structured output out, one pass.',
      why:
        'It reached 32% field-level accuracy, and the number was the smaller problem. Reading and extraction happened in the same pass, so a wrong field could mean the model misread the handwriting, or read it correctly and assigned it to the wrong key — with no way to tell which. It also failed quietly, returning fluent, schema-shaped, confidently wrong values. Splitting the stages apart, OCR first and then a constrained LLM, made every failure attributable to one of them. That is what turned an accuracy problem into a fixable one.',
    },
    outcome:
      'On a held-out set of 100 documents spanning handwriting, low-resolution scans, and complex layouts, field-level extraction accuracy went from 32% with the previous LLM-based pipeline to 80%, at 2.1 pages per second on an L40S with schema-valid JSON on 100% of runs. The verification database changed the reviewer’s job from transcribing fields to correcting them.',
    evidence: ['32% → 80% field-level accuracy', '100 held-out documents', '2.1 pages / sec on an L40S', '100% schema validity'],
    stack: ['LightOnOCR2', 'vLLM', 'llama.cpp' ,'Schema-constrained JSON', 'Verification database'],
  },
  {
    id: 'lidar-segmentation',
    area: '3D perception',
    title: 'Learning from severely imbalanced point clouds',
    period: '2025',
    question:
      'How do you improve minority-class learning without sacrificing the rest of a large outdoor scene?',
    context:
      'The enterprise dataset contained approximately 3 million labeled points, including transmission towers and conductors. Utility point clouds are dominated by common classes while operationally important classes can be rare, so overall accuracy can hide the failures that matter.',
    approach: [
      'Built on RandLA-Net and KPConvNeXt with focal loss and class-balanced re-weighting.',
      'Combined farthest-point and inverse-frequency sampling with targeted oversampling, tile-level rebalancing, and minority-class augmentation.',
      'Improved the training, preprocessing, and annotation loops through caching, batched I/O, and a redesigned labeling workflow.',
    ],
    outcome:
      'On held-out validation data, the operationally important minority class reached 92% IoU, against 98% IoU on the majority class. Overall accuracy also reads 98%, but on a point cloud this imbalanced that number is close to what predicting the majority class alone would score — the minority-class IoU is what the model was tuned and judged on. The work also shortened the iteration loop, and I mentored an intern through the modeling and data-pipeline work.',
    note:
      'Those ~3 million points did not label themselves. The intern and I spent two months annotating them, running on our last two brain cells.',
    evidence: ['92% minority-class IoU', '98% majority-class IoU', '~3M labeled points', 'Held-out validation'],
    stack: ['RandLA-Net', 'KPConvNeXt', 'PDAL', 'PyTorch', 'Focal Loss'],
  },
  {
    id: 'reconstruction',
    area: 'Research to production',
    title: 'From reconstruction papers to a production pipeline',
    period: '2024 – 2025',
    question:
      'What has to change when a promising 3D reconstruction method meets real images, runtime constraints, and deployment infrastructure?',
    context:
      'High-fidelity reconstruction from hundreds of high-resolution indoor images was useful only if processing time and rendering speed fit the operational workflow.',
    approach: [
      'Built a structure-from-motion pipeline with COLMAP and OpenSFM for 500+ image scenes.',
      'Integrated Gaussian Splatting and 2DGS for photorealistic real-time rendering.',
      'Moved to a GLOMAP-based architecture and containerized the pipeline for repeatable deployment.',
    ],
    outcome:
      'On comparable scenes, enabled 30 FPS rendering and reduced processing for complex scenes to under 60 minutes—an 80% speed improvement over the earlier architecture.',
    evidence: ['500+ image scenes', '30 FPS rendering', '<60 min processing', '80% faster on comparable scenes'],
    stack: ['COLMAP', 'GLOMAP', 'OpenSFM', 'Gaussian Splatting', 'Docker'],
  },
  {
    id: 'mobile-capture',
    area: 'Active experiment',
    title: 'On-device 3D capture with LiDAR priors',
    period: '2024 – Present',
    question:
      'Can mobile depth and pose estimates make field capture simpler while improving downstream reconstruction?',
    context:
      'Manual survey workflows are cumbersome, while image-only reconstruction can struggle without useful geometric priors.',
    approach: [
      'Fuse ARKit SLAM with iPad LiDAR depth for in-field point-cloud capture.',
      'Explore on-device and cloud-based Gaussian Splatting reconstruction paths.',
      'Design the capture flow around the constraints of the person collecting the data.',
    ],
    outcome:
      'The app is still in development. The current goal is a usable capture workflow and better depth priors—not a polished demo claim before the system has earned it.',
    evidence: ['ARKit pose', 'LiDAR depth', 'On-device + cloud paths'],
    stack: ['Swift', 'ARKit', 'LiDAR', 'SLAM', 'Gaussian Splatting'],
    status: 'In progress',
  },
];

type EarlierProject = {
