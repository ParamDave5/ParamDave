        title: 'Structure from Motion',
        year: '2022',
        description: 'A from-scratch SfM pipeline covering geometry, triangulation, and bundle adjustment.',
        github: 'https://github.com/ParamDave5/Structure-From-Motion',
        image: 'sfm.webp',
        alt: 'Sparse 3D point cloud and estimated camera poses recovered by bundle adjustment.',
      },
      {
        title: 'Stereo Vision',
        year: '2022',
        description: 'Calibration, rectification, correspondence, and metric depth from stereo imagery.',
        github: 'https://github.com/ParamDave5/Stereo-Vision',
        image: 'stereo.webp',
