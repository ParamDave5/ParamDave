    ],
  },
  {
    group: 'Deep Learning',
    projects: [
      {
        title: 'Gesture-Operated Robot',
        year: '2022',
        description: 'A Jetson Nano robot controlled by gestures from a lightweight OpenPose model at 20 FPS.',
        github: 'https://github.com/ParamDave5/Pose-Estimation-Gesture-Operated-Robot',
      },
      {
        title: '3D MRI CNN Super-Resolution',
        year: '2022',
        description: 'Reproduced and extended CNN-IL, improving SSIM and PSNR with a custom architecture.',
        github: 'https://github.com/ParamDave5/3D-MRI-CNN-Super-Resolution',
        image: 'mri-sr.webp',
        alt: 'Low-resolution MRI slice beside the super-resolved reconstruction.',
      },
      {
        title: 'SfMLearner',
        year: '2022',
        description: 'Extended monocular depth and ego-motion learning with a ResNet backbone and SSIM loss.',
        github: 'https://github.com/ParamDave5/SFM-Learner',
