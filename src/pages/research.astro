---
import Layout from '../layouts/Layout.astro';
import Publication from '../components/Publication.astro';
import AwardPhoto from '../components/AwardPhoto.astro';
import { award, roboticsCompetition } from '../data/achievements';
---
<Layout
  title="Research — Param Dave"
  description="MedReason 2026 paper, MedReason Award — fourth place, and RoboFineMani 2026 — seventh place."
>
  <section class="portfolio-shell py-8">
    <h1 class="mb-6 text-2xl font-semibold tracking-tight">Research</h1>

    <Publication />

    <section class="award-recognition" id="medreason-award" aria-labelledby="award-title">
      <AwardPhoto showCaption={false} sizes="(max-width: 700px) calc(100vw - 53px), 255px" />
      <div class="award-content">
        <p class="award-venue">MICCAI {award.year}</p>
        <h2 id="award-title">{award.name}</h2>
        <div class="award-result">
          <span class="award-badge">{award.placement}</span>
          <span>MedReason Challenge</span>
        </div>
        <div class="award-recipients">
          <p class="award-label">Awarded to</p>
          <ul>
            <li class="award-author">Param Dave</li>
            <li>Nishad Kulkarni</li>
            <li>Syed Muhammad Anwar</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="competition-record" id="robofinemani" aria-labelledby="competition-title">
      <div>
        <p class="eyebrow accent-text">Competition · {roboticsCompetition.year}</p>
        <h2 id="competition-title">{roboticsCompetition.name}</h2>
      </div>
      <p><strong>{roboticsCompetition.placement}</strong></p>
    </section>
  </section>
</Layout>
