---
import Layout from '../layouts/Layout.astro';
import Meme from '../components/Meme.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type ResearchPillar = {
  number: string;
  id: string;
  verb: string;
  area: string;
  status: string;
  question: string;
  thesis: string;
  current: string[];
  related?: string;
  readingGroups?: {
    label: string;
    papers: {
      title: string;
      focus: string;
      url: string;
    }[];
  }[];
};

const researchPillars: ResearchPillar[] = [
  {
    number: '01',
    id: 'physical-ai',
    verb: 'Act',
    area: 'Physical AI and spatial reasoning',
    status: 'New research direction',
    question:
      'How can an intelligent system learn from diverse experience, generalize across tasks and embodiments, and transfer reliably from simulation to the real world?',
    thesis:
      'Physical intelligence depends on more than a capable policy. It requires scalable data collection, representations that connect perception to action, and learning systems that transfer across tasks, environments, embodiments, and the simulation-to-reality gap.',
    current: [
      'Reading the Physical Intelligence π-series and GR00T to understand generalist vision-language-action policies, open-world generalization, and cross-embodiment transfer.',
      'Studying how teleoperation, human video, robot experience, and synthetic data can be collected and combined into scalable training mixtures.',
      'Connecting prior work in robotics, 3D perception, reconstruction, and geometry to sim-to-real transfer, adaptation from corrections, and failure diagnosis in long-horizon physical tasks.',
    ],
    readingGroups: [
      {
        label: 'Physical Intelligence · π model series',
        papers: [
          {
            title: 'π0: A Vision-Language-Action Flow Model for General Robot Control',
            focus: 'Generalist policies and continuous action generation',
            url: 'https://arxiv.org/abs/2410.24164',
          },
          {
            title: 'π0.5: A Vision-Language-Action Model with Open-World Generalization',
            focus: 'Knowledge transfer and generalization beyond the lab',
            url: 'https://arxiv.org/abs/2504.16054',
          },
          {
            title: 'π*0.6: A VLA That Learns From Experience',
            focus: 'Reinforcement learning from experience and corrections',
            url: 'https://arxiv.org/abs/2511.14759',
          },
        ],
      },
      {
        label: 'Physical Intelligence · research papers',
        papers: [
          {
            title: 'FAST: Efficient Action Tokenization for Vision-Language-Action Models',
            focus: 'Fast, transferable tokenization for high-frequency robot actions',
            url: 'https://www.pi.website/research/fast',
          },
          {
            title: 'Hi Robot: Open-Ended Instruction Following with Hierarchical VLAs',
            focus: 'Deliberative high-level reasoning paired with reactive control',
            url: 'https://www.pi.website/research/hirobot',
          },
          {
            title: 'Emergence of Human to Robot Transfer in Vision-Language-Action Models',
            focus: 'Human-video transfer enabled by diverse VLA pre-training',
            url: 'https://www.pi.website/research/human_to_robot',
          },
          {
            title: 'Knowledge Insulating Vision-Language-Action Models',
            focus: 'Preserving VLM knowledge while training efficient action experts',
            url: 'https://www.pi.website/research/knowledge_insulation',
          },
          {
            title: 'MEM: Multi-Scale Embodied Memory for Vision Language Action Models',
            focus: 'Visual short-term and semantic long-term memory for robot policies',
            url: 'https://www.pi.website/research/memory',
          },
          {
            title: 'Real-Time Execution of Action Chunking Flow Policies',
            focus: 'Asynchronous action generation without retraining the policy',
            url: 'https://arxiv.org/abs/2506.07339',
          },
          {
            title: 'Training-Time Action Conditioning for Efficient Real-Time Chunking',
            focus: 'Training policies for smooth, latency-aware real-time control',
            url: 'https://arxiv.org/abs/2512.05964',
          },
          {
            title: 'Precise Manipulation with Efficient Online RL',
            focus: 'Fast online adaptation for precise and dexterous manipulation',
            url: 'https://www.pi.website/research/rlt',
          },
        ],
      },
      {
        label: 'NVIDIA · GR00T',
        papers: [
          {
            title: 'NVIDIA Isaac GR00T N1: An Open Foundation Model for Humanoid Robots',
            focus: 'A dual-system foundation model for generalist humanoid control',
            url: 'https://arxiv.org/abs/2503.14734',
          },
        ],
      },
    ],
  },
  {
    number: '02',
    id: 'grounded-reasoning',
    verb: 'Ground',
    area: 'Grounded multimodal reasoning and post-training',
    status: 'Submission under evaluation',
    question:
      'Can a multimodal model connect its conclusion to the visual evidence that actually supports it?',
    thesis:
      'A fluent rationale isn\'t trustworthy simply because it sounds coherent. A grounded system should be right about the answer and expose whether its reasoning depends on the correct evidence.',
    current: [
      'Submitted work through an evaluation competition; details and results go up when I can share them.',
      'Working down the post-training line: PPO, then GRPO, its DAPO variant, and PAPO — which adds an implicit perception loss on top of GRPO so a multimodal model has to use the image instead of reasoning around it.',
      'Exploring corruption augmentation, gated rewards, and grounded verification for failures caused by degraded or shifted visual evidence.',
    ],
  },
  {
    number: '03',
    id: 'agent-evaluation',
    verb: 'Verify',
    area: 'Agent evaluation and failure diagnosis',
    status: 'Built & evolving',
    question:
      'How do we determine why an agent failed, not merely whether it failed?',
    thesis:
      'A single score hides the distinction between perception, generation, tool use, evaluation, and verification failures. An evaluation becomes useful when it identifies the behavior that broke and helps decide what to change next.',
    current: [
      'Designing pre-production quality gates with automated grading, adversarial probing, and red-teaming.',
      'Turning post-production failures into reproducible, component-level diagnoses instead of undifferentiated error logs.',
      'Testing whether synthetic questions resemble real user intent closely enough to expose meaningful weaknesses.',
    ],
    related: 'reliable-agents',
  },
];

const paperCount = (pillar: ResearchPillar) =>
  (pillar.readingGroups ?? []).reduce((total, group) => total + group.papers.length, 0);

const sourceLabel = (pillar: ResearchPillar) =>
  [...new Set((pillar.readingGroups ?? []).map((group) => group.label.split(' · ')[0]))]
    .join(' + ');

const principles = [
  {
    title: 'Diagnosis over a single score',
    copy: 'A metric should reveal which behavior failed and make the next engineering or research decision clearer.',
  },
  {
    title: 'Evidence over eloquence',
    copy: 'A confident explanation matters only when it is connected to the visual, textual, or physical evidence behind it.',
  },
  {
    title: 'Consequences change evaluation',
    copy: 'When a model can act in the world, partial observation, geometry, recovery, and the cost of failure become part of intelligence.',
  },
  {
    title: 'Research returns to the system',
    copy: 'An idea earns its value when it survives implementation, real workflows, and the failures that appear after deployment.',
  },
];
---
<Layout
  title="Research Manifesto — Param Dave"
  description="A research manifesto spanning agent evaluation, grounded multimodal reasoning, post-training, physical AI, and spatial intelligence."
>
  <section class="mx-auto max-w-5xl px-6 pt-11 pb-10 sm:pt-14">
    <p class="font-mono text-xs tracking-widest text-amber-600 uppercase dark:text-amber-400">
      Research manifesto
    </p>
    <h1 class="mt-3 max-w-4xl text-2xl font-semibold tracking-tight sm:text-4xl">
      Intelligence should be verifiable, grounded, and able to act in the world.
    </h1>
    <p class="mt-5 max-w-3xl text-base leading-relaxed text-stone-600 dark:text-stone-400">
      I'm interested in the path from models that generate plausible answers to systems that
      expose their evidence, diagnose their failures, and reason about the physical world. My
      research follows three connected frontiers: understand how intelligence learns to act,
      ground its reasoning in evidence, and verify its behavior when systems fail.
    </p>

    <Meme
      class="mt-8"
      tone="dark"
      eager
      imgWidth="390px"
      src="ai-time-dilation.webp"
      alt="Interstellar astronauts on an ocean planet beneath the caption: One month in AI is seven years everywhere else."
      width={914}
      height={514}
    >
      <p class="font-mono text-[10px] tracking-widest text-amber-400 uppercase">
        Research time dilation
      </p>
      <p class="mt-2 text-sm font-semibold leading-snug">
        Current bottleneck: papers are being published faster than I can read them.
      </p>
    </Meme>

    <nav class="mt-9 grid gap-3 sm:grid-cols-3" aria-label="Research pillars">
      {researchPillars.map((pillar) => (
        <a
          href={`#${pillar.id}`}
          class="group border-t-2 border-stone-300 pt-3 transition-colors hover:border-amber-500 dark:border-stone-700 dark:hover:border-amber-400"
        >
          <span class="font-mono text-[10px] text-stone-500 dark:text-stone-400">{pillar.number}</span>
          <span class="mt-2 block text-sm font-semibold group-hover:text-amber-600 dark:group-hover:text-amber-400">
            {pillar.verb}
          </span>
          <span class="mt-1 block text-xs leading-relaxed text-stone-500">{pillar.area}</span>
        </a>
      ))}
    </nav>
  </section>

  <section class="border-y border-stone-200 bg-stone-50/70 dark:border-stone-800 dark:bg-stone-900/30">
    <div class="mx-auto grid max-w-5xl gap-5 px-6 py-8 sm:grid-cols-[auto_1fr] sm:items-start sm:gap-12">
      <p class="text-xs font-semibold text-stone-500">Working belief</p>
      <p class="max-w-3xl text-sm leading-relaxed text-stone-700 dark:text-stone-300">
        Research is the disciplined reduction of uncertainty. The important questions are not
        chosen by novelty alone: they emerge where capability, evidence, and real-world behavior
        stop agreeing. Building the system tests whether the answer was actually useful.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-11">
    <div class="space-y-10">
      {researchPillars.map((pillar) => (
        <article id={pillar.id} class="scroll-mt-24 border-t border-stone-200 pt-10 first:border-t-0 first:pt-0 dark:border-stone-800">
          <header class="grid gap-5 lg:grid-cols-[0.34fr_1fr]">
            <div>
              <p class="text-xs font-semibold text-amber-600 dark:text-amber-400">
                {pillar.number} · {pillar.verb}
              </p>
              <span class="mt-3 inline-block rounded-full bg-stone-100 px-2.5 py-1 font-mono text-[10px] text-stone-600 dark:bg-stone-900 dark:text-stone-400">
                {pillar.status}
              </span>
            </div>
            <div>
              <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">{pillar.area}</h2>
              <p class="mt-4 max-w-3xl text-base font-medium leading-relaxed">{pillar.question}</p>
            </div>
          </header>

          <div class="mt-8 grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
            <div>
              <h3 class="text-xs font-semibold text-stone-500">Manifesto</h3>
              <p class="mt-3 text-sm leading-relaxed text-stone-700 dark:text-stone-300">
                {pillar.thesis}
              </p>

              {pillar.related && (
                <a
                  href={`${base}/projects#${pillar.related}`}
                  class="mt-5 inline-block text-sm font-medium text-amber-600 hover:underline dark:text-amber-400"
                >
                  See the related system →
                </a>
              )}
            </div>

            <div>
              <h3 class="text-xs font-semibold text-stone-500">Current direction</h3>
              <ul class="mt-3 space-y-3">
                {pillar.current.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-stone-700 dark:text-stone-300">
                    <span class="mt-2 inline-block h-1 w-1 shrink-0 rounded-full bg-amber-500"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {pillar.id === 'grounded-reasoning' && (
            <Meme
              class="mt-8"
              imgWidth="450px"
              src="pooh-hallucination.webp"
              alt="Three increasingly formal versions of Winnie the Pooh describing a model making something up, hallucinating, and performing evidentially ungrounded probabilistic synthesis."
              width={915}
              height={960}
            >
              <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                Same failure. Increasingly sophisticated vocabulary.
              </p>
            </Meme>
          )}

          {pillar.id === 'agent-evaluation' && (
            <Meme
              class="mt-8"
              imgWidth="420px"
              src="evaluation-always-has-been.webp"
              alt="One astronaut says that evaluation is part of the application while another replies: Always has been."
              width={900}
              height={500}
            >
              <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                Evaluation is not the final checkpoint. It is part of how the application gets built.
              </p>
            </Meme>
          )}

          {pillar.readingGroups && (
            <div class="mt-8 border-t border-stone-200 pt-6 dark:border-stone-800">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-xs font-semibold text-stone-500">Currently reading</h3>
                <span class="font-mono text-[10px] text-stone-500 dark:text-stone-400">
                  {paperCount(pillar)} papers · {sourceLabel(pillar)}
                </span>
              </div>
              <div class="mt-5 space-y-7">
                {pillar.readingGroups.map((group) => (
                  <section>
                    <h4 class="text-xs font-semibold text-amber-600 dark:text-amber-400">
                      {group.label}
                    </h4>
                    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                      {group.papers.map((paper) => (
                        <a
                          href={paper.url}
                          target="_blank"
                          rel="noopener"
                          class="rounded-lg bg-stone-50 p-4 transition-colors hover:bg-amber-50 dark:bg-stone-900/60 dark:hover:bg-amber-400/5"
                        >
                          <span class="block text-sm font-semibold leading-snug">{paper.title}</span>
                          <span class="mt-2 block text-xs leading-relaxed text-stone-500">{paper.focus}</span>
                          <span class="mt-3 block text-xs font-medium text-amber-600 dark:text-amber-400">Read paper ↗</span>
                        </a>
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-stone-200 bg-stone-50/70 dark:border-stone-800 dark:bg-stone-900/30">
    <div class="mx-auto max-w-5xl px-6 py-11">
      <p class="text-xs font-semibold text-stone-500">What I believe</p>
      <h2 class="mt-2 max-w-2xl text-xl font-semibold tracking-tight sm:text-2xl">
        Principles that connect the three frontiers
      </h2>
      <div class="mt-8 grid gap-x-8 gap-y-9 sm:grid-cols-2">
        {principles.map((principle, index) => (
          <article class="grid grid-cols-[auto_1fr] gap-4">
            <span class="font-mono text-[10px] text-amber-600 dark:text-amber-400">0{index + 1}</span>
            <div>
              <h3 class="text-base font-semibold">{principle.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                {principle.copy}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-10">
    <div class="grid gap-8 rounded-xl bg-stone-900 p-6 text-white sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center dark:bg-stone-100 dark:text-stone-900">
      <div>
        <p class="text-xs font-semibold text-amber-400 dark:text-amber-600">
          Research outputs
        </p>
        <h2 class="mt-2 text-xl font-semibold">Work in progress, claims when earned.</h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-stone-300 dark:text-stone-600">
          One multimodal submission is currently under evaluation. Papers, artifacts, and
          results go up here when they're public and I can stand behind them.
        </p>
      </div>
      <a
        href={`${base}/projects`}
        class="inline-block shrink-0 rounded-md bg-white px-4 py-2 text-sm font-medium text-stone-900 hover:bg-amber-300 dark:bg-stone-900 dark:text-white"
      >
        Explore shipped systems →
      </a>
    </div>
  </section>
</Layout>
