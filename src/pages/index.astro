---
import Layout from '../layouts/Layout.astro';
import { award, publication, roboticsCompetition } from '../data/achievements';
import { mailto, resumeUrl, github, linkedin } from '../data/site';
import '../styles/home.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = [
  { id: 'reliable-agents', title: 'Agentic evaluation platform', detail: 'Internal AI applications · Golden datasets, traces, and synthetic data workflows' },
  { id: 'document-intelligence', title: 'Document intelligence', detail: '32% → 80% field-level accuracy on 100 held-out documents' },
  { id: 'lidar-segmentation', title: 'LiDAR segmentation', detail: '92% minority-class IoU on held-out validation data' },
];
---
<Layout>
  <div class="portfolio-shell home-overview">
    <section class="home-profile" id="about" aria-labelledby="profile-name">
      <img class="home-portrait" src={`${base}/me.webp`} alt="Param Dave at the Golden Gate Bridge." width="400" height="480" fetchpriority="high" />
      <h1 id="profile-name">Param Dave</h1>
      <p class="home-role">TRC · Senior Machine Learning Engineer</p>
      <p class="home-focus">Agentic AI · Multimodal AI<br />Robotics · Research</p>
      <p class="home-bio">I build agentic evaluation platforms, document-intelligence pipelines, and 3D perception systems. My work connects research in AI, computer vision, and robotics to reliable applications.</p>
      <nav class="home-contact" aria-label="Contact and profiles">
        <a href={mailto}>Email</a>
        <a href={github} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={resumeUrl} target="_blank" rel="noopener">Résumé ↗</a>
      </nav>

      <section class="home-education" aria-labelledby="education-title">
        <h2 id="education-title">Education</h2>
        <div><h3>M.E. Robotics <time datetime="2023">2023</time></h3><p>University of Maryland, College Park</p></div>
        <div><h3>B.E. Mechanical Engineering <time datetime="2020">2020</time></h3><p>Nirma University</p></div>
      </section>
      <blockquote class="home-quote">
        <p>“We are a way for the cosmos to know itself.”</p>
        <footer><cite>Carl Sagan, Cosmos</cite></footer>
      </blockquote>
      <section class="home-personal" aria-labelledby="beyond-work-title">
        <h2 id="beyond-work-title">Beyond work</h2>
        <p>I look at stars for perspective and model traces for root causes. I enjoy history, markets, geopolitics, and theology; running, hiking, lifting, football, cricket, and tennis; and unwinding with sitcoms.</p>
      </section>
    </section>

    <div class="home-record">
      <section class="home-section" aria-labelledby="news-title">
        <header><h2 id="news-title">News</h2></header>
        <ul class="home-news">
          <li><time datetime={award.year}>{award.year}</time><p><a href={`${base}/research#medreason-award`}>{award.name}</a> — MedReason Challenge at MICCAI.</p></li>
          <li><time datetime={publication.year}>{publication.year}</time><p>Our <a href={publication.url} target="_blank" rel="noopener">medical visual question answering paper</a> is available in the MICCAI MedReason proceedings.</p></li>
          <li><time datetime={roboticsCompetition.year}>{roboticsCompetition.year}</time><p>{roboticsCompetition.placement} in <a href={`${base}/research#robofinemani`}>{roboticsCompetition.name}</a>.</p></li>
        </ul>
      </section>

      <section class="home-section" aria-labelledby="publication-title">
        <header><h2 id="publication-title">Publication</h2><a href={`${base}/research`}>Research ↗</a></header>
        <article class="home-publication" id="medreason-paper">
          <div>
            <h3><a href={publication.url} target="_blank" rel="noopener">{publication.title}</a></h3>
            <p class="home-authors"><strong>{publication.authors[0]}</strong>, {publication.authors.slice(1).join(', ')}</p>
            <p class="home-venue">{publication.venue}</p>
            <div class="home-paper-links"><a href={publication.url} target="_blank" rel="noopener">Paper ↗</a><a href={publication.pdf} target="_blank" rel="noopener">PDF ↗</a></div>
          </div>
        </article>
      </section>

      <section class="home-section" aria-labelledby="projects-title">
        <header><h2 id="projects-title">Selected projects</h2><a href={`${base}/projects`}>All projects ↗</a></header>
        <ul class="home-projects">
          {projects.map(project => <li><h3><a href={`${base}/projects#${project.id}`}>{project.title} <span aria-hidden="true">↗</span></a></h3><p>{project.detail}</p></li>)}
        </ul>
      </section>

      <section class="home-section" aria-labelledby="experience-title">
        <header><h2 id="experience-title">Experience</h2><a href={`${base}/experience`}>Full experience ↗</a></header>
        <ul class="home-experience">
          <li><div><h3>TRC Inc</h3><p>Senior Machine Learning Engineer</p></div><span>2025–Present</span></li>
          <li><div><h3>B Garage</h3><p>Research Intern · Depth estimation</p></div><span>2022</span></li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
